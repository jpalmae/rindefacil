# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production-256bit-key
FLASK_APP=app

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sixmanager_gastos
POSTGRES_USER=sixmanager
POSTGRES_PASSWORD=change-me-in-production

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-in-production
MINIO_BUCKET_RECEIPTS=receipts
MINIO_SECURE=false

# OpenRouter (Kimi K2 / Z.ai)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL_OCR=moonshotai/kimi-k2
OPENROUTER_MODEL_FALLBACK=google/gemini-2.0-flash-exp

# Email
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@sixmanager.com

# OAuth
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
MICROSOFT_CLIENT_ID=xxx
MICROSOFT_CLIENT_SECRET=xxx

# Application
APP_URL=http://localhost:5000
APP_NAME=Rinde Fácil

# Rate Limiting
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=100/hour
RATELIMIT_AUTH=10/hour

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
